{
	"name": "python-ydoc-suede",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"diff": "difftastic ./reference/jupyter_ydoc/javascript/src/ ./release/",
		"test:server": "DOCKERFILE=\"docker/y-websocket-server/compose.yml\"; docker compose -f $DOCKERFILE down && docker compose -f $DOCKERFILE up --build yjs-websocket-server",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"dependencies": {
		"@jupyterlab/nbformat": "^3.0.0 || ^4.0.0-alpha.21 || ^4.0.0",
		"@lumino/coreutils": "^1.11.0 || ^2.0.0",
		"@lumino/disposable": "^1.10.0 || ^2.0.0",
		"@lumino/signaling": "^1.10.0 || ^2.0.0",
		"fast-diff": "^1.3.0",
		"y-protocols": "^1.0.5",
		"y-websocket": "^3.0.0",
		"yjs": "^13.5.40"
	},
	"devDependencies": {
		"@storybook/test": "^8.6.15",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"dockview": "^4.13.1",
		"dockview-core": "^4.13.1",
		"html-to-image": "^1.11.13",
		"svelte": "^5.48.2",
		"svelte-check": "^4.3.5",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	}
}
